#include <iostream>
#include <stack>

using namespace std;

int main() {
    stack<int> S;
    int sum = 0;

    S.push(21);
    S.push(22);
    S.push(23);
    S.push(24);
    S.push(25);

    while (!S.empty()) {
        int num = S.top();
        cout << num << " ";
        sum += num;
        S.pop();
    }
    
    cout << endl;
    cout << sum << endl;

    return 0;
}
