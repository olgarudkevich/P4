#include <iostream>
#include <stack>
#include <cstdlib>
#include <ctime>

using namespace std;

int main() {
    srand(time(0));
    stack<int> S;
    int maxSize = 12;
    int minVal = 10;
    int maxVal = 40;
    
    cout << "Згенеровані числа:" << endl;
    for (int i = 0; i < maxSize; ++i) {
        int randomNum = rand() % (maxVal - minVal + 1) + minVal;
        S.push(randomNum);
        cout << randomNum << " ";
    }
    cout << endl;

    int sum = 0;
    int count = 0;

    cout << "Числа, що відповідають критерію (непарні від 20 до 40):" << endl;
    while (!S.empty()) {
        int num = S.top();
        if (num % 2 != 0 && num >= 20 && num <= 40) {
            cout << num << " ";
            sum += num;
            count++;
        }
        S.pop();
    }
    cout << endl;

    if (count > 0) {
        double average = static_cast<double>(sum) / count;
        cout << "Середнє значення: " << average << endl;
    } else {
        cout << "Немає чисел, що відповідають критерію." << endl;
    }

    return 0;
}
